<Window
    x:Class="MeetingBar.SettingsApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuración de MeetingBar">
  <Grid x:Name="RootGrid" Language="es-CR" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="24,0,0,0">
      <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="12"/>
    </Grid>

    <NavigationView x:Name="Navigation" Grid.Row="1" IsPaneOpen="True" PaneDisplayMode="Left" OpenPaneLength="300"
                    IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    AlwaysShowHeader="False" SelectionChanged="Navigation_SelectionChanged" Background="Transparent">
      <NavigationView.PaneHeader>
        <StackPanel Width="252" Margin="4,4,0,16">
          <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource AccentFillColorDefaultBrush}">
              <FontIcon Glyph="&#xE787;" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="MeetingBar" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Tu calendario a mano" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Widget" Tag="Widget" x:Name="WidgetItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Calendarios" Tag="Calendars" x:Name="CalendarsItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE787;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Eventos" Tag="Events" x:Name="EventsItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Reuniones" Tag="Meetings" x:Name="MeetingsItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE714;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Recordatorios" Tag="Reminders" x:Name="RemindersItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA8F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="General" Tag="General" x:Name="GeneralItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Pruebas" Tag="Debug" x:Name="DebugItem"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.Content>
        <ScrollViewer x:Name="PageScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
          <Grid Padding="36,14,40,38" HorizontalAlignment="Stretch">
            <StackPanel x:Name="PagePanel" MaxWidth="820" HorizontalAlignment="Stretch"/>
          </Grid>
        </ScrollViewer>
      </NavigationView.Content>
    </NavigationView>

    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid Margin="300,0,38,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <InfoBar x:Name="SaveStatus" IsOpen="False" IsClosable="False" Severity="Success" Message="Configuración guardada y aplicada" VerticalAlignment="Center" Margin="0,7,18,7"/>
        <Button Grid.Column="1" x:Name="SaveButton" Content="Guardar" Style="{StaticResource AccentButtonStyle}" MinWidth="92" VerticalAlignment="Center" Click="SaveButton_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
