<Window x:Class="MeetingBar.Windows.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MeetingBar.Windows.Views"
        Title="MeetingBar" Icon="/Resources/MeetingBar.ico" Width="410" Height="650" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="False" Background="Transparent" Deactivated="Window_Deactivated">
  <Border x:Name="PopupSurface" Background="#44202020" BorderBrush="#66767676" BorderThickness="1" CornerRadius="8" Padding="18" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#66202020" CornerRadius="9" Padding="10,7,10,8" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="TIMELINE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
          <views:DayTimelineControl Events="{Binding Events}" Height="62" AutomationProperties.Name="Event timeline"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}" CornerRadius="11" Padding="15" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Header}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
          <views:EmojiTextBlock Grid.Row="1" EmojiText="{Binding NextTitle}" Style="{StaticResource EmojiText}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
          <TextBlock Grid.Row="2" Text="{Binding NextMeta}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,13,0,0">
            <Button Command="{Binding JoinCommand}" IsEnabled="{Binding CanJoinNext}" Style="{StaticResource AccentButton}"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="Video" Stroke="White" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock Text="Join meeting"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>

      <views:AutoHideScrollViewer Grid.Row="2">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid x:Name="EventRow" Margin="1,0,6,4" Background="Transparent" ToolTipService.InitialShowDelay="320" ToolTipService.BetweenShowDelay="80" ToolTipService.ShowDuration="60000">
                  <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Opacity" Value="0.42"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                  <Grid.ToolTip>
                    <ToolTip Placement="Right" HorizontalOffset="10" Background="Transparent" BorderThickness="0" Padding="0" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <Border Background="#FF2B2B2B" BorderBrush="#FF666666" BorderThickness="1" CornerRadius="11" Padding="14" Width="290">
                        <StackPanel>
                          <views:EmojiTextBlock EmojiText="{Binding Title}" Style="{StaticResource EmojiText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <StackPanel Orientation="Horizontal" Margin="0,5,0,10"><TextBlock Text="{Binding TimeRange}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Countdown}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                          <Separator Background="#66707070" Margin="0,0,0,9"/>
                          <TextBlock Text="{Binding CalendarDetails}" Margin="0,0,0,4"/>
                          <TextBlock Text="{Binding OrganizerDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding LocationDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding MeetingDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                          <TextBlock Text="{Binding DetailsNotes}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="150" Margin="0,5,0,0"/>
                        </StackPanel>
                      </Border>
                    </ToolTip>
                  </Grid.ToolTip>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{Binding CalendarColor}" CornerRadius="2" Margin="0,4"/>
                  <StackPanel Grid.Column="1" Margin="10,8,4,8">
                    <TextBlock Text="{Binding Start, StringFormat={}{0:t}}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Countdown}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,8">
                    <views:EmojiTextBlock EmojiText="{Binding Title}" Style="{StaticResource EmojiText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CalendarName}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="3" Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanJoin, Converter={StaticResource BooleanVisibility}}" Padding="7" Margin="6,5,3,5">
                    <Image Source="{Binding MeetingService, Converter={StaticResource MeetingServiceIcon}}" Width="18" Height="18" Stretch="Uniform"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Bookmarks}" Margin="0,10,0,0">
            <ItemsControl.Template><ControlTemplate><StackPanel><TextBlock Text="BOOKMARKS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,3,2,7"/><ItemsPresenter/></StackPanel></ControlTemplate></ItemsControl.Template>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" HorizontalContentAlignment="Left" Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </views:AutoHideScrollViewer>

      <Grid Grid.Row="3" Margin="0,13,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding CreateMeetingCommand}"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="Plus" Stroke="{StaticResource InkBrush}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Create meeting"/></StackPanel></Button>
          <Button Command="{Binding OpenCalendarCommand}" IsEnabled="{Binding CanOpenCalendar}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="CalendarDays" Stroke="{StaticResource InkBrush}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Open calendar"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Command="{Binding RefreshCommand}" Padding="9,7"><views:LucideIcon Kind="RefreshCw" Stroke="{StaticResource InkBrush}" Width="15" Height="15"/></Button>
          <Button Click="Settings_Click" Padding="9,7" Margin="8,0,0,0"><views:LucideIcon Kind="SlidersHorizontal" Stroke="{StaticResource InkBrush}" Width="15" Height="15"/></Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="20" Visibility="{Binding LoadingVisibility}" Background="#B8202020" CornerRadius="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="120" Height="3" ClipToBounds="True" Background="#446E6E6E">
            <Border Width="40" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="2">
              <Border.RenderTransform><TranslateTransform x:Name="LoaderTranslate" X="-40"/></Border.RenderTransform>
            </Border>
            <Grid.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LoaderTranslate" Storyboard.TargetProperty="X" From="-40" To="120" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Grid.Triggers>
          </Grid>
          <TextBlock Text="Loading calendars…" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
