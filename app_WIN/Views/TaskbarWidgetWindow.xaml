<Window x:Class="MeetingBar.Windows.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/MeetingBar.ico" Width="300" Height="40" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent">
  <Button Click="Widget_Click" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="Open MeetingBar">
    <Border Background="#EE171B26" BorderBrush="#554A536B" BorderThickness="1" CornerRadius="7" Padding="9,4">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding WidgetGlyph}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Grid.Column="1" Text="{Binding WidgetTitle}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0"/>
        <TextBlock Grid.Column="2" Text="{Binding WidgetTime}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Button>
</Window>
