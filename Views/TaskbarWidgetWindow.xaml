<Window x:Class="MeetingBar.Windows.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MeetingBar.Windows.Views"
        Title="MeetingBar" Icon="/MeetingBar;component/Resources/MeetingBar.ico" Width="300" Height="40" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent">
  <Window.Resources>
    <Style x:Key="TaskbarTooltip" TargetType="ToolTip">
      <Setter Property="Background" Value="#FF252525"/>
      <Setter Property="Foreground" Value="#FFF6F6F6"/>
      <Setter Property="BorderBrush" Value="#FF606060"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MaxWidth" Value="344"/>
      <Setter Property="Placement" Value="Top"/>
      <Setter Property="VerticalOffset" Value="-6"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
        <TextBlock Text="{Binding}" Foreground="#FFF6F6F6" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="320" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
      </DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Button Click="Widget_Click" MouseEnter="Widget_MouseEnter" MouseLeave="Widget_MouseLeave" Padding="0" BorderThickness="0" Background="#01000000" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Button.Template><ControlTemplate TargetType="Button"><Grid Background="#01000000"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid></ControlTemplate></Button.Template>
    <Border x:Name="WidgetSurface" Background="#01000000" BorderThickness="0" CornerRadius="4" Padding="0" SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="WidgetSurface_SizeChanged">
      <Grid ClipToBounds="True">
        <Border x:Name="ShineLayer" Width="72" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
          <Border.RenderTransform><TranslateTransform x:Name="ShineTransform" X="-90"/></Border.RenderTransform>
        </Border>
        <Grid VerticalAlignment="Center" Margin="9,2,10,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="16" Height="16" CornerRadius="4" Background="{Binding WidgetEventColor}" VerticalAlignment="Center" Visibility="{Binding WidgetIconVisibility}"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <views:EmojiTextBlock x:Name="WidgetTitle" EmojiText="{Binding WidgetTitle}" Style="{StaticResource EmojiText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" FontSize="10" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Margin="6,0,5,0">
            <views:EmojiTextBlock.ToolTip><ToolTip Style="{StaticResource TaskbarTooltip}" Content="{Binding PlacementTarget.DataContext.WidgetTitle, RelativeSource={RelativeSource Self}}"/></views:EmojiTextBlock.ToolTip>
          </views:EmojiTextBlock>
          <TextBlock Text="{Binding WidgetSubtitle}" Visibility="{Binding HasWidgetSubtitle, Converter={StaticResource BooleanVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="10" LineHeight="14" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Margin="6,0,5,0"/>
          </StackPanel>
          <TextBlock Grid.Column="2" x:Name="WidgetTime" Text="{Binding WidgetTime}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="10" LineHeight="14" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center">
            <TextBlock.ToolTip><ToolTip Style="{StaticResource TaskbarTooltip}" Content="{Binding PlacementTarget.DataContext.WidgetTime, RelativeSource={RelativeSource Self}}"/></TextBlock.ToolTip>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>
  </Button>
</Window>
