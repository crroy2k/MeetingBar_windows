<Window x:Class="MeetingBar.Windows.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizaciones de MeetingBar" Width="540" Height="430" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="White" Icon="/Resources/MeetingBar.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Actualizaciones" FontSize="24" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,12,0,14">
      <TextBlock x:Name="VersionText" Foreground="#C0C0C0"/>
      <TextBlock x:Name="StatusText" Text="Buscando la versión más reciente…" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#C0C0C0"/></ScrollViewer>
    <ProgressBar x:Name="DownloadProgress" Grid.Row="3" Height="5" Margin="0,14,0,14" Visibility="Collapsed" Maximum="100"/>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Fuente: GitHub · Latest" Foreground="#999999" FontSize="10" VerticalAlignment="Center"/>
      <Button x:Name="ActionButton" Grid.Column="1" Content="Buscar de nuevo" Click="Action_Click" IsEnabled="False"/>
    </Grid>
  </Grid>
</Window>
